        if (isNaN(width)) continue;
        if (width >= boxWidthTemp && (width - boxWidthTemp) < minDiff) {
          minDiff = width - boxWidthTemp;
          location = availData[i][0];
        }
      }
      if (!location) return "추천 LOC 없음";
    }

    if (!boxSize || boxSize.toString().trim() === "") return location;

    // --- 4. 박스 사이즈 ---
    var boxDims = boxSize.toString().split("*").map(Number);
    if (boxDims.length !== 3 || boxDims.some(isNaN)) return "박스 사이즈 오류";
    var boxWidth = boxDims[0], boxLength = boxDims[1], boxHeight = boxDims[2];

    // --- 5. 로케이션 높이 ---
    var numSheet = ss.getSheetByName("Num-of-Items");
    if (!numSheet) return "Num-of-Items 시트 없음";
    var locsData = numSheet.getRange("B2:C" + numSheet.getLastRow()).getValues();
    var locHeight = null;
    for (var i = 0; i < locsData.length; i++) {
      if (locsData[i][0] === location) {
        locHeight = Number(locsData[i][1]);
        break;
      }
    }
    if (!locHeight || isNaN(locHeight)) return "로케이션 높이 없음";
    var palletHeight = locHeight - 6;

    // --- 6. width ---
    var availWidth = null;
    for (var i = 0; i < availData.length; i++) {
      if (availData[i][0] === location) {
        availWidth = Number(availData[i][1]);
        break;
      }
    }
    if (!availWidth || isNaN(availWidth)) availWidth = boxWidth;

    // --- 7. pallet 고정 값 ---
    var palletLength = 43;
    var palletWidth = 43;

    // --- 8. 레이어 계산 ---
    var boxesPerRowWidth = Math.floor(palletWidth / boxWidth);           
    var boxesPerRowLength = Math.floor((palletLength + 2) / boxLength); 
    var boxesPerLayer = boxesPerRowWidth * boxesPerRowLength;
    if (boxesPerLayer <= 0) return "적재 불가";

    // --- 9. 기존 재고 기준 ---
    var currentBoxes = Math.ceil(totalStock / boxQty);
    var currentLayers = Math.ceil(currentBoxes / boxesPerLayer);
    var usedHeight = currentLayers * boxHeight;

    // --- 10. 추가 가능 레이어 ---
    var remainHeight = palletHeight - usedHeight;
    var addLayers = Math.floor(remainHeight / boxHeight);

    if (addLayers <= 0) {
      var remainQty = Math.max(dInboundQty, 0);
      return "공간부족\n현재: " + currentBoxes + " box, " + remainQty + " ea";
    }

    // --- 11. 한 팔렛 1 라인 정책 ---
    var maxAddBoxes = addLayers * boxesPerRowLength;
    var moveBoxes = Math.min(maxAddBoxes, Math.ceil(dInboundQty / boxQty));
    var moveQty = Math.min(moveBoxes * boxQty, dInboundQty);
    var remainingQty = dInboundQty - moveQty;

    // --- 결과 ---
    return location + "\n이동 가능수량: " + moveQty + "ea (" + moveBoxes + ")" +
           "\n남는 수량: " + remainingQty + "ea";

  } catch (e) {
    return "계산 오류: " + e.message;
  }
}


function RECOMM_LOCATION_ORG(dInboundQty, mCurrLocs, nQty, boxQty, boxSize) {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var location = "";
  var totalStock = 0;
  var useRecommended = false;

  // --- 0. mCurrLocs 공백 체크 ---
  if (!mCurrLocs || mCurrLocs.toString().trim() === "") return "";

  // --- 0. 숫자 강제 변환 (NaN 방지) ---
  dInboundQty = Number(dInboundQty);
  nQty = Number(nQty);
  boxQty = Number(boxQty);
  if (isNaN(dInboundQty) || isNaN(nQty) || isNaN(boxQty)) return "숫자 데이터 오류";

  // --- 1. 현재 로케이션 확인 ---
  var lines = mCurrLocs.toString().split("\n").filter(l => l.trim() !== "");
  if (lines.length > 0) {
    var locs = [];
    lines.forEach(l => {
      var parts = l.split("/");
      if (parts.length < 3) return;
      var loc = parts[0].trim();
      var qty = Number(parts[2].trim());
      if (!isNaN(qty)) {
        locs.push(loc);
        totalStock += qty;
      }
    });
    var uniqueLocs = [...new Set(locs)];
    if (uniqueLocs.length === 1) location = uniqueLocs[0];
    else return "";
  } else useRecommended = true;

  // --- 2. 사용가능 로케이션 시트 ---
  var availSheet = ss.getSheetByName("사용가능 로케이션");
  if (!availSheet) return "사용가능 로케이션 시트 없음";
  var availData = availSheet.getRange("A2:B" + availSheet.getLastRow()).getValues();

  // --- 3. 추천 로케이션 ---
  if (useRecommended) {
    if (!boxSize || boxSize.toString().trim() === "") return "";
    var boxWidthTemp = Number(boxSize.toString().split("*")[0]);
    var minDiff = Infinity;
    availData.forEach(r => {
      if (!r[0]) return;
      var width = Number(r[1]);
      if (isNaN(width)) return;
      var diff = Math.abs(width - boxWidthTemp);
      if (diff < minDiff) {
        minDiff = diff;
        location = r[0];
      }
    });
  }

  if (!boxSize || boxSize.toString().trim() === "") return location;

  // --- 4. 박스 사이즈 ---
  var boxDims = boxSize.toString().split("*").map(Number);
  if (boxDims.length !== 3 || boxDims.some(isNaN)) return "박스 사이즈 오류";
  var boxWidth = boxDims[0];
  var boxLength = boxDims[1];
  var boxHeight = boxDims[2];

  // --- 5. 로케이션 높이 ---
  var numSheet = ss.getSheetByName("Num-of-Items");
  if (!numSheet) return "Num-of-Items 시트 없음";
  var locsData = numSheet.getRange("B2:C" + numSheet.getLastRow()).getValues();
  var locHeight = null;
  for (var i = 0; i < locsData.length; i++) {
    if (locsData[i][0] === location) {
      locHeight = Number(locsData[i][1]);
      break;
    }
  }
  if (!locHeight || isNaN(locHeight)) return "로케이션 높이 없음";
  var palletHeight = locHeight - 6;

  // --- 6. width ---
  var availWidth = null;
  for (var i = 0; i < availData.length; i++) {
    if (availData[i][0] === location) {
      availWidth = Number(availData[i][1]);
      break;
    }
  }
  if (!availWidth || isNaN(availWidth)) availWidth = boxWidth;

  // --- 7. pallet 고정 값 ---
  var palletLength = 43; // 기본
  var palletWidth = 43;  // 고정

  // --- 8. 레이어 계산 ---
  var boxesPerRowWidth = Math.floor(palletWidth / boxWidth);           // width는 넘어갈 수 없음
  var boxesPerRowLength = Math.floor((palletLength + 2) / boxLength); // length는 2인치 오버 허용
  var boxesPerLayer = boxesPerRowWidth * boxesPerRowLength;
  if (boxesPerLayer <= 0) return "적재 불가";

  // --- 9. 기존 재고 기준 ---
  var currentBoxes = Math.ceil(totalStock / boxQty);
  var currentLayers = Math.ceil(currentBoxes / boxesPerLayer);
  var usedHeight = currentLayers * boxHeight;

  // --- 10. 추가 가능 레이어 ---
  var remainHeight = palletHeight - usedHeight;
  var addLayers = Math.floor(remainHeight / boxHeight);

  if (addLayers <= 0) {
    var remainQty = Math.max(dInboundQty, 0);
    return "공간부족\n현재: " + currentBoxes + " box, " + remainQty + " ea";
  }

  // --- 11. 한 팔렛 1 라인 정책 반영 ---
  // 한 레이어에 한 제품만 사용 → 이동 가능 박스 = addLayers * boxesPerRowLength
  var maxAddBoxes = addLayers * boxesPerRowLength;

  // --- 12. 입고 수량 기준으로 이동 가능 박스 계산 ---
  var moveBoxes = Math.min(maxAddBoxes, Math.ceil(dInboundQty / boxQty));
  
  // --- 13. 실제 이동 가능 수량이 입고 수량을 초과하면 조정 ---
  var moveQty = Math.min(moveBoxes * boxQty, dInboundQty);

  // --- 14. 남는 수량 계산 ---
  var remainingQty = dInboundQty - moveQty;

  // --- 15. 결과 ---
  return location + "\n이동 가능수량: " + moveQty + "ea (" + moveBoxes + ")" +
         "\n남는 수량: " + remainingQty + "ea";
}


