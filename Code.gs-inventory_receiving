function updateBoxQtyBatch() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  if (ss.getName() !== "2026 재고 노출 현황") {
    SpreadsheetApp.getUi().alert("2026 재고 노출 현황 파일에서만 실행 가능합니다.");
    return;
  }

  // 🔹 CON-NUM!G1 에서 sourceGid 읽기
  const configTab = ss.getSheetByName("CON-NUM");
  const sourceGid = Number(configTab.getRange("G1").getValue());

  if (!Number.isInteger(sourceGid)) {
    SpreadsheetApp.getUi().alert("CON-NUM!G1 에 유효한 숫자 gid 값이 없습니다.");
    return;
  }

  // 🔹 gid 정확 일치 시트 찾기
  const sourceTab = ss.getSheets().find(sh => sh.getSheetId() === sourceGid);

  if (!sourceTab) {
    SpreadsheetApp.getUi().alert(
      `CON-NUM!G1 의 gid(${sourceGid}) 와 정확히 일치하는 탭이 없습니다.`
    );
    return;
  }

  const sourceLastRow = sourceTab.getLastRow();
  if (sourceLastRow < 2) return;

  // 🔹 A~P (16컬럼) 읽기 (O=14, P=15)
  const sourceData = sourceTab.getRange(2, 1, sourceLastRow - 1, 16).getValues();

  const normalizeSku = sku =>
    String(sku || "").replace(/[\s\r\n\t]+/g, "").trim();

  const updateArray = sourceData
    .filter(row => Number(row[14]) > 0) // O 컬럼 QTY
    .map(row => ({
      sku: normalizeSku(row[0]),
      boxQty: Number(row[14]),
      boxDim: row[15] || "" // P 컬럼 DIM
    }));

  if (updateArray.length === 0) {
    SpreadsheetApp.getUi().alert("업데이트할 O 컬럼에 0 보다 큰 항목이 없습니다.");
    return;
  }

  // 🔹 TARGET
  const TARGET_SPREADSHEET_ID = "1_kZm34SavTpnsaq4HXxFx-v3o7krywKxbU3XaAeCIUA";
  const targetSS = SpreadsheetApp.openById(TARGET_SPREADSHEET_ID);
  const targetTab = targetSS.getSheetByName("BOX-QTY-PER-SKU");

  // 🔹 QTY 카운트
  let qtyUpdate = 0;
  let qtyInsert = 0;
  let qtySkip = 0;

  // 🔹 DIM 카운트
  let dimUpdate = 0;
  //let dimUpdateSkus = "";
  let dimInsert = 0;
  let dimSkip = 0;

  updateArray.forEach(({ sku, boxQty, boxDim }) => {
    const finder = targetTab
      .getRange("A:A")
      .createTextFinder(sku)
      .matchEntireCell(true)
      .findNext();

    if (finder) {
      const row = finder.getRow();

      // ===== BOX QTY 처리 (D컬럼) =====
      const currentQty = targetTab.getRange(row, 4).getValue();
      if (Number(currentQty) !== Number(boxQty)) {
        targetTab.getRange(row, 4).setValue(boxQty);
        qtyUpdate++;
      } else {
        qtySkip++;
      }

      // ===== BOX DIM 처리 (E컬럼) =====
      const currentDim = targetTab.getRange(row, 5).getValue();
      const cleanBoxDim = String(boxDim).trim();
      
      if (cleanBoxDim !== "") { // 공백이 아닐 때만 값 비교 및 업데이트
        if (String(currentDim).trim() !== cleanBoxDim) {
          targetTab.getRange(row, 5).setValue(boxDim);
          dimUpdate++;
          //dimUpdateSkus = dimUpdateSkus + "," + sku;
        } else {
          dimSkip++;
        }
      } else {
        dimSkip++;
      }

    } else {
      // 🔹 SKU 없음 → 신규 추가
      const lastRow = targetTab.getLastRow() + 1;

      targetTab.getRange(lastRow, 1, 1, 5).setValues([[ 
        sku,      // A
        "Y",      // B
        0,        // C
        boxQty,   // D
        boxDim    // E
      ]]);

      qtyInsert++;
      dimInsert++;
    }
  });

  SpreadsheetApp.getUi().alert(
    `BOX QTY 처리 완료\n` +
    `업데이트: ${qtyUpdate}건\n` +
    `신규 추가: ${qtyInsert}건\n` +
    `변경 없음: ${qtySkip}건\n` +
    `\nBOX DIM 처리 완료\n` +
    `업데이트: ${dimUpdate}건\n` +
    `신규 추가: ${dimInsert}건\n` +
    `변경 없음: ${dimSkip}건`
  );
}



function updateBoxDim() {

  const sourceSS = SpreadsheetApp.getActiveSpreadsheet();
  const sourceSheet = sourceSS.getSheetByName("Box-Info-Update");

  const targetSS = SpreadsheetApp.openById("1_kZm34SavTpnsaq4HXxFx-v3o7krywKxbU3XaAeCIUA");
  const targetSheet = targetSS.getSheetByName("BOX-QTY-PER-SKU");

  // SOURCE : A3:F
  const sourceLastRow = sourceSheet.getLastRow();
  if (sourceLastRow < 3) {
    SpreadsheetApp.getUi().alert("Box-Info-Update 시트에 데이터가 없습니다.");
    return;
  }

  const sourceData = sourceSheet.getRange(3, 1, sourceLastRow - 2, 6).getValues(); // A~F

  // TARGET
  const targetLastRow = targetSheet.getLastRow();
  const targetData = targetLastRow > 1
    ? targetSheet.getRange(2, 1, targetLastRow - 1, 5).getValues()
    : [];

  // SKU → 배열 index
  const skuMap = {};
  targetData.forEach((row, i) => {
    const sku = String(row[0]).trim();
    if (sku) {
      skuMap[sku] = i;
    }
  });

  let nNewCount = 0;
  let nBoxDimCount = 0;
  let nOuterQtyBoxCount = 0;

  const appendRows = [];

  sourceData.forEach(row => {

    const sku = String(row[0]).trim();
    const dim = row[3];             // D
    const outerQty = row[5];        // F

    if (!sku) return;

    const idx = skuMap[sku];

    if (idx !== undefined) {

      // ===== Outer Qty 업데이트 =====
      const srcOuterQty = parseInt(outerQty, 10);
      const tgtOuterQty = parseInt(targetData[idx][3], 10);

      if (
        Number.isInteger(srcOuterQty) &&
        srcOuterQty > 0 &&
        srcOuterQty !== tgtOuterQty
      ) {
        targetData[idx][3] = srcOuterQty;
        nOuterQtyBoxCount++;
      }

      // ===== DIM 업데이트 =====
      if (
        dim !== null &&
        dim !== "" &&
        String(dim).trim() !== "" &&
        String(targetData[idx][4]).trim() !== String(dim).trim()
      ) {
        targetData[idx][4] = dim;
        nBoxDimCount++;
      }

    } else {

      // ===== 신규 추가 =====
      appendRows.push([
        sku,
        "Y",
        0,
        (parseInt(outerQty, 10) > 0 ? parseInt(outerQty, 10) : 0),
        dim
      ]);

      nNewCount++;
    }

  });

  // 기존 데이터 저장
  if (targetData.length > 0) {
    targetSheet.getRange(2, 1, targetData.length, 5).setValues(targetData);
  }

  // 신규 추가
  if (appendRows.length > 0) {
    targetSheet
      .getRange(targetSheet.getLastRow() + 1, 1, appendRows.length, 5)
      .setValues(appendRows);
  }

  SpreadsheetApp.getUi().alert(
    "신규 추가 : " + nNewCount + " 건\n" +
    "BOX DIM : " + nBoxDimCount + " 건\n" +
    "Outer Qty per Box : " + nOuterQtyBoxCount + " 건"
  );

}


function updateBoxQty() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();

  if (ss.getName() !== "2026 재고 노출 현황") {
    SpreadsheetApp.getUi().alert("2026 재고 노출 현황 파일에서만 실행 가능합니다.");
    return;
  }

  // 🔹 소스: "2026 재고 노출 현황" 시트의 ACTIVE 탭
  //const sourceSheet = ss.getSheetByName("2026 재고 노출 현황");
  //const sourceTab = ss.getActiveSheet();
  const sourceTab = ss.getSheetByName("TW 3차");
  const sourceLastRow = sourceTab.getLastRow();
  if (sourceLastRow < 2) return;

  // 🔹 TARGET 스프레드시트
  const TARGET_SPREADSHEET_ID = "1_kZm34SavTpnsaq4HXxFx-v3o7krywKxbU3XaAeCIUA";
  const targetSS = SpreadsheetApp.openById(TARGET_SPREADSHEET_ID);
  const targetTab = targetSS.getSheetByName("CMS-SKU-LIST");
  if (!targetTab) {
    SpreadsheetApp.getUi().alert("CMS-SKU-LIST 탭을 찾을 수 없습니다.");
    return;
  }

  const targetLastRow = targetTab.getLastRow();
  if (targetLastRow < 2) return;

  // 🔹 데이터 읽기
  const sourceData = sourceTab.getRange(2, 1, sourceLastRow - 1, 17).getValues();
  //const targetData = targetTab.getRange(2, 1, targetLastRow - 1, 7).getValues();

  // 🔹 SKU 정규화 함수
  const normalizeSku = sku => String(sku || "").replace(/[\s\r\n\t]+/g, "").trim();

  // 🔹 Q>0인 source SKU만 배열로 저장
  const updateArray = [];
  sourceData.forEach(row => {
    const sku = normalizeSku(row[0]);
    const boxQty = Number(row[16]) || 0;
    if (sku && boxQty > 0) {
      updateArray.push({ sku, boxQty });
    }
  });

  console.log("Q>0 SKU count:", updateArray.length);

  if (updateArray.length === 0) {
    SpreadsheetApp.getUi().alert("업데이트할 Q>0 항목이 없습니다.");
    return;
  }

  const BATCH_SIZE = 1000; // 한 번에 처리할 행 수

  let updateCount = 0;

  for (let startRow = 2; startRow <= targetLastRow; startRow += BATCH_SIZE) {
    const numRows = Math.min(BATCH_SIZE, targetLastRow - startRow + 1);
    const targetData = targetTab.getRange(startRow, 1, numRows, 7).getValues();

    // SKU → 인덱스 맵
    const targetMap = {};
    targetData.forEach((row, idx) => {
      const sku = normalizeSku(row[0]);
      if (sku) targetMap[sku] = idx;
    });

    // updateArray에 포함된 SKU만 처리
    updateArray.forEach(item => {
      const { sku, boxQty } = item;
      if (targetMap.hasOwnProperty(sku)) {
        const idx = targetMap[sku];
        targetData[idx][6] = boxQty;
        updateCount++;
      }
    });

    // 블록 단위 반영
    targetTab.getRange(startRow, 1, numRows, 7).setValues(targetData);
  }

  SpreadsheetApp.getUi().alert(`BOX QTY 업데이트 완료\n총 업데이트: ${updateCount}건`);
}

