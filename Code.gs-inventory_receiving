function sendSelectedSkuToCms() {
  const sheet = SpreadsheetApp.getActiveSheet();
  const sheetName = sheet.getName();

  const range = sheet.getActiveRange();
  if (!range) {
    SpreadsheetApp.getUi().alert("셀을 선택 후 사용하세요.");
    return;
  }

  const sku = range.getValue()?.toString().trim();
  if (!sku) {
    SpreadsheetApp.getUi().alert("SKU 셀을 선택 후 사용하세요.");
    return;
  }

  const webAppUrl = "https://script.google.com/macros/s/AKfycbzPH5Pu-tZvcwEOyROSn-n0rpJbX9f1I2Z42eJ6Q1F-dGjMYIO_zjHQqmbkUkKxLd9-/exec";

  const url = webAppUrl + "?sku=" + encodeURIComponent(sku) + "&sheet=" + encodeURIComponent(sheetName);

  try {
    const response = UrlFetchApp.fetch(url);
    const result = JSON.parse(response.getContentText());

    if (!result || result.error) {
      SpreadsheetApp.getUi().alert(result?.error || "데이터 조회 오류");
      return;
    }

    
    SpreadsheetApp.getUi().alert(
      "SKU: " + result.sku +
      "\nQTY: " + result.qty +
      "\nUPC: " + result.upc +
      "\nLOCATION: " + result.location
    );
    

    // 다음 단계용 로그 (중요)
    console.log(JSON.stringify({
      sku: result.sku,
      location: result.location
    }));
  } catch (e) {
    SpreadsheetApp.getUi().alert("Web App 호출 중 오류 발생: " + e.message);
  }
}




/*
----- RECOMM_LOCATION 함수 관련 시작

*/


// '사용가능 로케이션' 시트 데이터를 한 번만 불러와서 캐싱하는 함수
function getAvailData() {
  if (!_availDataCache) {
    var ss = SpreadsheetApp.getActiveSpreadsheet();
    var sheet = ss.getSheetByName("사용가능 로케이션");
    if (sheet) {
      var lastRow = Math.max(2, sheet.getLastRow());
      _availDataCache = sheet.getRange("A2:B" + lastRow).getValues();
    } else {
      _availDataCache = [];
    }
  }
  return _availDataCache;
}

// 'Num-of-Items' 시트 데이터를 한 번만 불러와서 빠른 검색(Map) 형태로 캐싱하는 함수
function getLocHeightMap() {
  if (!_locHeightMap) {
    _locHeightMap = {};
    var ss = SpreadsheetApp.getActiveSpreadsheet();
    var sheet = ss.getSheetByName("Num-of-Items");
    if (sheet) {
      var lastRow = Math.max(2, sheet.getLastRow());
      var data = sheet.getRange("B2:C" + lastRow).getValues();
      for (var i = 0; i < data.length; i++) {
        if (data[i][0]) {
          _locHeightMap[data[i][0]] = Number(data[i][1]);
        }
      }
    }
  }
  return _locHeightMap;
}

function RECOMM_LOCATION(dInboundQty, mCurrLocs, nQty, boxQty, boxSize) {
  try {
    var location = "";
    var totalStock = 0;
    var useRecommended = false;

    // --- 0. 공백 체크 및 안전한 문자열 변환 ---
    if (!mCurrLocs || String(mCurrLocs).trim() === "") return "";

    // --- 0. 숫자 강제 변환 (NaN 방지) ---
    dInboundQty = Number(dInboundQty);
    nQty = Number(nQty);
    boxQty = Number(boxQty);
    if (isNaN(dInboundQty) || isNaN(nQty) || isNaN(boxQty)) return "숫자 데이터 오류";

    // --- 1. 현재 로케이션 확인 ---
    var lines = String(mCurrLocs).split("\n").filter(function(l) { return l.trim() !== ""; });
    if (lines.length > 0) {
      var locs = [];
      for (var i = 0; i < lines.length; i++) {
        var parts = lines[i].split("/");
        if (parts.length < 3) continue;
        var loc = parts[0].trim();
        var qty = Number(parts[2].trim());
        if (!isNaN(qty)) {
          locs.push(loc);
          totalStock += qty;
        }
      }
      var uniqueLocs = [...new Set(locs)];
      if (uniqueLocs.length === 1) {
        location = uniqueLocs[0];
      } else {
        return "다중 LOCATION";
      }
    } else {
      useRecommended = true;
    }

    // --- 2. 사용가능 로케이션 시트 데이터 (캐시에서 즉시 로드) ---
    var availData = getAvailData();
    if (!availData || availData.length === 0) return "사용가능 로케이션 시트 없음";

    // --- 3. 추천 로케이션 ---
    if (useRecommended) {
      if (!boxSize || String(boxSize).trim() === "") return "";
      var boxWidthTemp = Number(String(boxSize).split("*")[0]);
      var minDiff = Infinity;
      for (var i = 0; i < availData.length; i++) {
        if (!availData[i][0]) continue;
        var width = Number(availData[i][1]);
        if (isNaN(width)) continue;
        if (width >= boxWidthTemp && (width - boxWidthTemp) < minDiff) {
          minDiff = width - boxWidthTemp;
          location = availData[i][0];
        }
      }
      if (!location) return "추천 LOC 없음";
    }

    if (!boxSize || String(boxSize).trim() === "") return location;

    // --- 4. 박스 사이즈 ---
    var boxDims = String(boxSize).split("*").map(Number);
    if (boxDims.length !== 3 || boxDims.some(isNaN)) return "박스 사이즈 오류";
    var boxWidth = boxDims[0], boxLength = boxDims[1], boxHeight = boxDims[2];

    // --- 5. 로케이션 높이 (캐시된 Map 객체에서 for문 없이 즉시 찾기) ---
    var locHeightMap = getLocHeightMap();
    var locHeight = locHeightMap[location];
    
    if (!locHeight || isNaN(locHeight)) return "로케이션 높이 없음";
    var palletHeight = locHeight - 6;

    // --- 6. width ---
    var availWidth = null;
    for (var i = 0; i < availData.length; i++) {
      if (availData[i][0] === location) {
        availWidth = Number(availData[i][1]);
        break;
      }
    }
    if (!availWidth || isNaN(availWidth)) availWidth = boxWidth;

    // --- 7. pallet 고정 값 ---
    var palletLength = 43;
    var palletWidth = 43;

    // --- 8. 레이어 계산 ---
    var boxesPerRowWidth = Math.floor(palletWidth / boxWidth);
    var boxesPerRowLength = Math.floor((palletLength + 2) / boxLength);
    var boxesPerLayer = boxesPerRowWidth * boxesPerRowLength;
    if (boxesPerLayer <= 0) return "적재 불가";

    // --- 9. 기존 재고 기준 ---
    var currentBoxes = Math.ceil(totalStock / boxQty);
    var currentLayers = Math.ceil(currentBoxes / boxesPerLayer);
    var usedHeight = currentLayers * boxHeight;

    // --- 10. 추가 가능 레이어 ---
    var remainHeight = palletHeight - usedHeight;
    var addLayers = Math.floor(remainHeight / boxHeight);

    if (addLayers <= 0) {
      var remainQty = Math.max(dInboundQty, 0);
      return "공간부족\n현재: " + currentBoxes + " box, " + remainQty + " ea";
    }

    // --- 11. 한 팔렛 1 라인 정책 ---
    var maxAddBoxes = addLayers * boxesPerRowLength;
    var moveBoxes = Math.min(maxAddBoxes, Math.ceil(dInboundQty / boxQty));
    var moveQty = Math.min(moveBoxes * boxQty, dInboundQty);
    var remainingQty = dInboundQty - moveQty;

    // --- 결과 ---
    return location + "\n이동 가능수량: " + moveQty + "ea (" + moveBoxes + ")" +
           "\n남는 수량: " + remainingQty + "ea";

  } catch (e) {
    return "계산 오류: " + e.message;
  }
}



